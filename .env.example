PORT=3002

# OpenAI 兼容接口（DeepSeek / OpenAI / 硅基流动等均可）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# Google Maps（需启用 Maps JavaScript API、Directions API；搜索建议再启用 Places API）
GOOGLE_MAPS_API_KEY=

# MySQL（docker compose 默认端口 3309，避免与第九节课旅行规划AI 的 3308 冲突）
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=travel_planner_user
DB_PASSWORD=travel_planner_pass
DB_NAME=travel_planner
